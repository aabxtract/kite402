# Hedera
HEDERA_ACCOUNT_ID=0.0.XXXXXX
HEDERA_PRIVATE_KEY=302e...
HEDERA_NETWORK=testnet

# HCS Topic (create once, reuse)
HCS_TOPIC_ID=0.0.XXXXXX

# Encryption
ENCRYPTION_KEY=<32-byte hex>   # openssl rand -hex 32

# JWT
JWT_SECRET=<random 64 chars>

# Database
DATABASE_URL=postgres://...

# Privy (server-side verification)
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# x402 Facilitator (Blocky402 — open x402 facilitator supporting Hedera testnet)
X402_FACILITATOR_URL=https://api.testnet.blocky402.com

# Public origin used to build protected URLs. Leave unset on Vercel — the
# request's own origin is used, so preview and production each emit their own
# hostname. Set it only to pin a custom domain.
# PROXY_BASE_URL=https://your-domain.com

# Next.js — leave unset now that the gateway is served from this same
# deployment (relative paths). Set only when pointing at a separate gateway.
# NEXT_PUBLIC_PROXY_URL=
NEXT_PUBLIC_PRIVY_APP_ID=
