{
  "name": "kite402",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "web",
    "proxy"
  ],
  "scripts": {
    "dev:proxy": "bun run --cwd proxy dev",
    "dev:web": "bun run --cwd web dev",
    "db:generate": "bun run --cwd packages/shared db:generate",
    "db:push": "bun run --cwd packages/shared db:push"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
